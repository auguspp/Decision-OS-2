h1{font-size:40px;line-height:1.35;font-weight:750;letter-spacing:-.025em;margin:24px 0 28px;max-width:930px}
h2{font-size:24px;line-height:1.5;margin:42px 0 18px;padding-top:22px;border-top:1px solid var(--line)}p{margin:14px 0}strong{font-weight:720}main>p:first-of-type{font-size:20px;line-height:1.75;border-left:4px solid var(--accent);background:#edf5f1;padding:22px 26px;border-radius:0 6px 6px 0}
