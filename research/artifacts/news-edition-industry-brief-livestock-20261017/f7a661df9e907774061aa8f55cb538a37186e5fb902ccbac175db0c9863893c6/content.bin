e45a3adfbf0be0e33d66e3ddea38ef01ad716779f684e26329c35803"},"selection":{"columns":[],"end":5,"kind":"lines","start":1}},"source":{"acquired_at":"2026-10-17T00:40:11.482455+00:00","custody":"excerpt","entities":[{"aliases":["牧原食品股份有限公司","牧原食品集团股份有限公司","002714.SZ"],"attributes":[["security_code","002714.SZ"]],"entity_id":"company-muyuan","kind":"company","name":"牧原股份"}],"kind":"content","limitations":["NECESSARY_ATTRIBUTED_FACT_EXCERPT_NOT_FULL_TEXT_OR_OPEN_LICENSE","CURATED_ROLE_NOT_ORIGINAL_AUTHENTICATION_OR_CURRENT_BUSINESS_REVALIDATION","NO_COMPANY_NET_EXPOSURE_PROFIT_CASH_FLOW_OR_RESEARCH_ACCEPTANCE","MIRROR_OF_ISSUER_FILING_NOT_ORIGINAL_PDF","SECOND_COPY_SAME_FILING_NOT_INDEPENDENT_EVIDENCE=https://wap.stockstar.com/detail/SN2026032700044044","ROLE_REPORT_PERIOD_2025_NOT_CURRENT_CONTRACTS_OR_HEDGE_HOLDINGS"],"origin":"https://www.9fzt.com/detail/sz_002714_9_b73b17d3f52225026fb8266f0f48ad31.html","published_at":"2026-03-28","report_period":"2025-01-01/2025-12-31","source_id":"muyuan-2025-feed-purchase-role-excerpt","title":"牧原2025年报玉米及豆粕采购角色必要摘录（公告镜像文本）"},"text":"牧原食品股份有限公司｜2025年年度报告｜证券代码002714。\n出处：九方智投公告全文镜像；页面载明2026-03-28。套期章节“其他说明—注1”，镜像文本邻接页码217；另核证券之星同一报告文本。未取得并渲染发行人PDF，两镜像不是两个独立经营证据。\n必要短引：玉米、豆粕采购。\n事实摘录（非全文）：年报在2025年度套期说明中把预计购入玉米及豆粕、未来生猪出售的价格波动列入风险管理，并说明以商品期货进行现金流量套期。公司业务包括饲料制造及养殖销售。\n用途与限制：只据此保留2025报告期披露的原料买方角色；未确认2026年九月或当前实际采购数量、配方、等级、合同价格、库存成本、套保头寸及执行效果，不能把历史披露或计划额度当当前锁价。\n"},"exposure_size_note":"市场调查序列仅供背景；公司对应等级、地区、税费、数量、成本权重及净头寸未核，不当公司成交价。","lag":null,"net_benefit":null,"pass_through":null,"qualification":"curated-role-and-transmission-hypotheses-not-authenticated-or-causal","relation_id":"muyuan-corn-purchaser-2025","report_period":"2025-01-01/2025-12-31","role":"purchaser","status":"retained-issuer-inputs","subject_id":"nbs-material-f0e7172a4429135f56586b14","transmission":{"cash_flow":{"counterevidence":"账期、预付款、存货量、保证金和回款未知，不把价差当现金流。","hypothesis":"同量采购若涨价，可能增加付款或营运资金需求。"},"cost":{"counterevidence":"配方替代、实际等级、合同基准、库存成本与采购时滞未知。","hypothesis":"其余条件相同，购入原料涨价可能增加饲料支出。"},"profit":{"counterevidence":"未核配方权重、耗料、出栏、套期及一体化抵销，不计算利润弹性。","hypothesis":"投入与产出价格相对变化可能影响毛利。"},"revenue":{"counterevidence":"原料涨幅不是生猪售价或收入涨幅。","hypothesis":"原料供给及价格可影响养殖安排，收入影响须另核。"}},"unknowns":["历史报告期不延续为2026年10月当前经营认证。","NBS规格与实际采购/销售规格未证同一，不算份额或敏感度。","饲料配方、替代、库存、合同、套期、内部抵销及净受益未知。"]}],"result_sha256":"5a6fd638acb63307f0e3e3db104fdb3e75b28d9c54180d13ebebc193c3b59999","retained_scope":{"accepted_relations":3,"declared_relations":3,"series":3,"unavailable_inputs":0},"root_limitations":["ORIGINAL_CURATED_PACKET_REFERENCING_EXISTING_SOURCE_VERSIONS","NOT_CURRENT_MARKET_PRICE_OR_CURRENT_COMPANY_NET_EXPOSURE","ISSUER_EXCERPTS_FROM_MIRROR_AND_SEARCH_INDEX_NOT_ORIGINAL_PDF","THREE_SERIES_NOT_THREE_NEW_MONITORED_PRODUCTS_OR_500_PLUS"],"root_original_verified":false,"series":{"changes":[{"delta":"-27.3","from_index":0,"interpretation":"observation-change-not-company-benefit","percent_change":"-1.2204935622317596566523605150214592274678111587982832618025751072961373390557939914163090128755364806866952789699570815450643777","reason_code":null,"status":"changed","to_index":1},{"delta":"-43.2","from_index":1,"interpretation":"observation-change-not-company-benefit","percent_change":"-1.9551934826883910386965376782077393075356415478615071283095723014256619144602851323828920570264765784114052953156822810590631365","reason_code":null,"status":"changed","to_index":2}],"latest_change":{"delta":"-43.2","from_index":1,"interpretation":"observation-change-not-company-benefit","percent_change":"-1.9551934826883910386965376782077393075356415478615071283095723014256619144602851323828920570264765784114052953156822810590631365","reason_code":null,"status":"changed","to_index":2},"points":[{"assessment":"period-average","contract":"not-applicable","currency":"CNY","frequency":"ten-day","market":"spot","metric":"circulation-wholesale-and-sales-price","original_verified":false,"period_end":"2026-09-10","period_kind":"price-level","period_start":"2026-09-01","price_kind"