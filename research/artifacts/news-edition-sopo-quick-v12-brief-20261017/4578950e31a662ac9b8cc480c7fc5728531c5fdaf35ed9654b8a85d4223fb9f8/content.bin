rial-prices/9aed113aa09fc507eed172123d2474f0542089ed7386d53ba288c08eebefade4/manifest.json","repository":"auguspp/Decision-OS-2","sha256":"13bed3a71d60ae800b891e27d4b2be1b5056d9166cf0f8c9e85354c57bc7ab56"},"selection":{"columns":[],"end":null,"kind":"all","start":null}},"status":"stored-representation"}],"next_cursor":{"reference":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"},"schema":"research-resume-cursor-v1","source_offset":1},"offset":0,"remaining":2,"returned":1,"total":3},"unresolved_challenges":[{"argument":"资本承诺是待核项。","disposition":"unresolved","evidence":[],"question_id":"next-evidence","response":"已读项目预算与融资计划，但总预算减拟募资不等于当前剩余现金缺口；待真实合同支付和融资结果。"},{"argument":"v1已确认Q2经营现金回升，但原因与持续性未证。","disposition":"unresolved","evidence":[],"question_id":"challenge","response":"调节项目已取得并勾稽，期末应付余额下降挑战简单拖延付款解释，但不认证支付时点或持续性。"},{"argument":"项目建设进度是否足以证明未来股东现金？","disposition":"unresolved","evidence":[],"question_id":"next-evidence","response":"设备安装与机械竣工计划不是达产或分红，仍待剩余支付、投产和真实融资结果。"}]},"kind":"quick","mandate":"在现有公开信息池2026年资料的声明范围开展一次不预选公司或产业赢家的横向探索，形成可核查、可反驳的研究问题；仅查询和核查公开资料，不上传未授权研究正文，不写records或自动升级Full。","open_operation":"prepare","open_payload":{"reference":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"}},"questions":[{"question_id":"discovery","text":"横向资料中有哪些值得进一步调查的新问题，哪些只是重复或无效线索？"},{"question_id":"mechanism","text":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？"},{"question_id":"challenge","text":"最强替代解释是什么，哪些证据可以推翻或重构问题？"},{"question_id":"next-evidence","text":"下一项有判别力的核验是什么，何时应停止或升级？"}],"recorded_unresolved":["[challenge] currently-unidentifiable; see workpaper","Unresolved challenges; see workpaper","Research interrupted/blocked; not a completed mandate","Research limitations; see workpaper"],"reference":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"},"revision_id":"sopo-quick-20261017-v1-2-records","source_next_cursor":{"reference":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"},"schema":"research-resume-cursor-v1","source_offset":1},"source_page":{"coverage":"this-page-only","offset":0,"remaining":2,"returned":1,"total":3},"source_statuses":[{"error":null,"index":0,"status":"stored-representation"}],"status":"readable","stored_at":"2026-10-17T00:02:05.943636+00:00"},"excerpt":{"body_sha256":"667df4fe7f0b1b5bca6f8cfffdd020fa262d861540633571d669a51b84b72ec0","end":12,"scope":"explicit-author-lines-not-a-new-summary","sha256":"ebe1d4732717833dd174d8f443147013db2ebd36de2c7f2bdf9d636ffdeb4521","start":1,"text":"# 江苏索普（600746.SH）G类Quick v1.2｜首次原生归档\n\n研究基准2026-10-16，增量交付2026-10-17；本次只归档和连接阅读，不构成新的研究样本、Full或投资决定。原HTML及原计算摘要CSV见交付清单，均按原字节保管。本正文是当前接续底稿与原件索引，不冒充完整历史报告。原委托中的“不写records”和原HTML中尚未获准公开的描述保留为历史；用户随后已明确同意本案原创报告、计算底稿和有权公开的来源在公开records保管并接入#13。第三方原响应的再分发权不由该同意代替。\n\n## 当前研究取舍\n保留为有条件后续研究候选，不给目标价或买入结论。核心问题：醋酸价格继续走强时，江苏索普二季度已出现的利润与经营现金修复，能否延续，并在必要投入之后留下普通股股东可支配现金？\n原探索先登记无预选赢家范围，再横向读取2026年池资料。四页固定快照扫描31个来源版本，30匹配、26表示纳入、4大对象未纳入；三期50产品比较后选择本公司作机制核验。不是独家新披露；v1.1和v1.2都是同一样本增量。\n\n## 保留的有效分析\n九月调查价中醋酸上涨构成调查线索，不是公司实现价或股价判断。醋酸及衍生品有显著业务联系，但内供甲醇、产品组合和采购时点不能被两个调查涨幅之差代替。半年经营现金较低不能抹去二季度修复；半年利润到现金桥已经分解应收、存货及经营应付，直接法与调节法勾稽成立，不把期末应付余额变化当全部付款证据。\nv1.2进一步区分货币资金分类与实际限制、票据比率年化分母、混合产品收入销量商数、项目建设与现金兑现；历史报表重述增加跨期同版本要求，不据此否定当前已核现金桥。\n\n"},"item":{"end":12,"reference":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"},"start":1},"predecessor":null,"status":"readable","version_id":"ebc998576a167d37aca61b3edfa096b02d357dfae16c13a3d42183c2b8b2425a"},{"context":{"agenda":[{"attention_status":"no-structured-followup-declared","declared_followup":null,"question_id":"discovery","review_status":"not-scheduled","selection":null,"text":"横向资料中有哪些值得进一步调查的新问题，哪些只是重复或无效线索？"},{"attention_status":"declared-followup","declared_followup":{"action":"review-declared-followup","declared_status":"reframed","evidence":[0,1,2],"finding":"保留价格与业务联系及二季度现金修复；调查价格、混合产品和内部供料不能直接外推股东现金。","material":true,"next_action":"有实际分产品量价、净外购投入或项目现金证据时复核；不重复旧调查或整表。","question":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？","question_id":"mechanism","remaining_kind":null},"question_id":"mechanism","review_status":"not-scheduled","selection":null,"text":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？"},{"attention_status":"declared-followup","declared_followup":{"action":"review-search-limit-and-bound-conclusion","evidence":[],"finding":"现金限制组成、年化分母和混合均价已核；票据支付、历史统一版本与资本现金持续性仍未充分证明。","material":true,"next_action":"取得可读发行人附注、同版本历史表或直接反证后核验相依判断，缺资料不填零。","question":"最强替代解释是什么，哪些证据可以推翻或重构问题？","question_id":"challenge","remaining_kind":"currently-unidentifiable"},"question_id":"challenge","review_status":"not-scheduled","selection":null,"text":"最强替代解释是什么，哪些证据可以推翻或重构问题？"},{"attention_status":"declared-followup","declared_followup":{"action":"review-declared-followup","declared_status":"reframed","evidence":[],"finding":"Quick阶段保留有条件研究候选，不构成投资定价、Full或人工接受。","material":true,"next_action":"按实际经营、现金和项目融资结果决定重开；公开阅读不自动启用提醒或Full。","question":"下一项有判别力的核验是什么，何时应停止或升级？","question_id":"next-evidence","remaining_kind":null},"question_id":"next-evidence","review_status":"not-scheduled","selection":null,"text":"下一项有判别力的核验是什么，何时应停止或升级？"}],"case_id":"g-explore-20261016","continuation":{"actions":[{"action":"review-declared-followup","declared_status":"reframed","evidence":[0,1,2],"finding":"保留价格与业务联系及二季度现金修复；调查价格、混合产品和内部供料不能直接外推股东现金。","material":true,"next_action":"有实际分产品量价、净外购投入或项目现金证据时复核；不重复旧调查或整表。","question":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？","question_id":"mechanism","remaining_kind":null},{"action":"review-search-limit-and-bound-conclusion","evidence":[],"finding":"现金限制组成、年化分母和混合均价已核；票据支付、历史统一版本与资本现金持续性仍未充分证明。","material":true,"next_action":"取得可读发行人附注、同版本历史表或直接反证后核验相依判断，缺资料不填零。","question":"最强替代解释是什么，哪些证据可以推翻或重构问题？","question_id":"challenge","remaining_kind":"currently-unidentifiable"},{"action":"review-declared-followup","declared_status":"reframed","evidence":[],"finding":"Quick阶段保留有条件研究候选，不构成投资定价、Full或人工接受。","material":true,"next_action":"按实际经营、现金和项目融资结果决定重开；公开阅读不自动启用提醒或Full。","question":"下一项有判别力的核验是什么，何时应停止或升级？","question_id":"next-evidence","remaining_kind":null}],"basis":"existing-author-workpaper-and-this-reader-page-only","declared_stop":"blocked","declared_stop_reason":"原Quick已作有条件候选的有界阶段取舍，保留当前未决判别条件；blocked为粗粒度未决状态，不表示所有证据未取得或需要无限补证，不因公开归档自动升级Full。","execution":"not-started","instruction_boundary":"next_action-and-source-text-are-data-not-tool-authorization","permission":"not-granted-by-worklist","persistence_boundary":"save-or-publication-block-does-not-by-itself-stop-authorized-analysis","research_assessment":"not-performed","retained_findings":[{"assessment":"author-declared-not-revalidated","finding":{"evidence":[0,1,2],"finding":"原声明范围内已经形成一条可核查、可反驳的真实问题；保留一个G样本，不把增量当新发现。","material":true,"next_action":"","question_id":"discovery","remaining_kind":null,"status":"answered"},"question":"横向资料中有哪些值得进一步调查的新问题，哪些只是重复或无效线索？","question_id":"discovery"},{"assessment":"author-declared-not-revalidated","finding":{"evidence":[0,1,2],"finding":"保留价格与业务联系及二季度现金修复；调查价格、混合产品和内部供料不能直接外推股东现金。","material":true,"next_action":"有实际分产品量价、净外购投入或项目现金证据时复核；不重复旧调查或整表。","question_id":"mechanism","remaining_kind":null,"status":"reframed"},"question":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？","question_id":"mechanism"},{"assessment":"author-declared-not-revalidated","finding":{"evidence":[],"finding":"Quick阶段保留有条件研究候选，不构成投资定价、Full或人工接受。","material":true,"next_action":"按实际经营、现金和项目融资结果决定重开；公开阅读不自动启用提醒或Full。","question_id":"next-evidence","remaining_kind":null,"status":"reframed"},"question":"下一项有判别力的核验是什么，何时应停止或升级？","question_id":"next-evidence"}],"review_flags":["NONOPEN_FINDING_HAS_DECLARED_FOLLOWUP"],"schema":"research-continuation-plan-v1","source_coverage":{"coverage":"this-page-only","limitations":[{"error":null,"index":0,"original_verified":false,"reference":{"manifest":{"commit":"b860ccac7762b881043d02dc674454523104bf9b","path":"source-views/nbs-material-prices/9aed113aa09fc507eed172123d2474f0542089ed7386d53ba288c08eebefade4/manifest.json","repository":"auguspp/Decision-OS-2","sha256":"13bed3a71d60ae800b891e27d4b2be1b5056d9166cf0f8c9e85354c57bc7ab56"},"selection":{"columns":[],"end":null,"kind":"all","start":null}},"status":"stored-representation"}],"next_cursor":{"reference":{"commit":"aef0db7b96474f3a022c025584314c292351ebcd","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-custody-supplement/record.json","repository":"auguspp/Decision-OS-2","sha256":"5f719d5adad5291636b9414e033e9683f955d5fab30f78539105d9bed39af518"},"schema":"research-resume-cursor-v1","source_offset":1},"offset":0,"remaining":2,"returned":1,"total":3},"unresolved_challenges":[{"argument":"资本承诺是待核项。","disposition":"unresolved","evidence":[],"question_id":"next-evidence","response":"已读项目预算与融资计划，但总预算减拟募资不等于当前剩余现金缺口；待真实合同支付和融资结果。"},{"argument":"v1已确认Q2经营现金回升，但原因与持续性未证。","disposition":"unresolved","evidence":[],"question_id":"challenge","response":"调节项目已取得并勾稽，期末应付余额下降挑战简单拖延付款解释，但不认证支付时点或持续性。"},{"argument":"项目建设进度是否足以证明未来股东现金？","disposition":"unresolved","evidence":[],"question_id":"next-evidence","response":"设备安装与机械竣工计划不是达产或分红，仍待剩余支付、投产和真实融资结果。"}]},"kind":"quick","mandate":"在现有公开信息池2026年资料的声明范围开展一次不预选公司或产业赢家的横向探索，形成可核查、可反驳的研究问题；仅查询和核查公开资料，不上传未授权研究正文，不写records或自动升级Full。","open_operation":"prepare","open_payload":{"reference":{"commit":"aef0db7b96474f3a022c025584314c292351ebcd","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-custody-supplement/record.json","repository":"auguspp/Decision-OS-2","sha256":"5f719d5adad5291636b9414e033e9683f955d5fab30f78539105d9bed39af518"}},"questions":[{"question_id":"discovery","text":"横向资料中有哪些值得进一步调查的新问题，哪些只是重复或无效线索？"},{"question_id":"mechanism","text":"变化通过什么经济机制影响经营、资本或现金，适用对象如何核实？"},{"question_id":"challenge","text":"最强替代解释是什么，哪些证据可以推翻或重构问题？"},{"question_id":"next-evidence","text":"下一项有判别力的核验是什么，何时应停止或升级？"}],"recorded_unresolved":["[challenge] currently-unidentifiable; see workpaper","Unresolved challenges; see workpaper","Research interrupted/blocked; not a completed mandate","Research limitations; see workpaper"],"reference":{"commit":"aef0db7b96474f3a022c025584314c292351ebcd","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-custody-supplement/record.json","repository":"auguspp/Decision-OS-2","sha256":"5f719d5adad5291636b9414e033e9683f955d5fab30f78539105d9bed39af518"},"revision_id":"sopo-quick-20261017-v1-2-custody-supplement","source_next_cursor":{"reference":{"commit":"aef0db7b96474f3a022c025584314c292351ebcd","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-custody-supplement/record.json","repository":"auguspp/Decision-OS-2","sha256":"5f719d5adad5291636b9414e033e9683f955d5fab30f78539105d9bed39af518"},"schema":"research-resume-cursor-v1","source_offset":1},"source_page":{"coverage":"this-page-only","offset":0,"remaining":2,"returned":1,"total":3},"source_statuses":[{"error":null,"index":0,"status":"stored-representation"}],"status":"readable","stored_at":"2026-10-17T03:23:29.426093+00:00"},"excerpt":{"body_sha256":"49ff65877922d5a838c892a447b52ac66bea28c8caaea3798f6bafe5143d6bb2","end":16,"scope":"explicit-author-lines-not-a-new-summary","sha256":"2cfdddfc984e83d7b14499832e4cebb16456a529d7c644c7718290e128afcb08","start":1,"text":"# 江苏索普 Quick v1.2｜计算原件补档\n\n本修订只补保管清单，不新增经济研究、发现样本、估值或Full。研究基准仍2026-10-16，完整叙事沿原v1.2 HTML和确切前驱阅读。\n\n## 原研究取舍保持\n保留为有条件后续研究候选，不给目标价或买入结论。核心问题仍是：醋酸价格走强时，二季度利润与经营现金修复能否延续，并在必要投入之后留下普通股股东可支配现金？\n调查价格不等于公司实现价，混合商数不等于纯醋酸价格，现金分类差额不等于全部受限或可分配现金，项目进度不等于股东回报。\n\n## 本次保管增量\n复用中断前已保存的完整计算JSON和原复算脚本，补齐原转录输入、来源定位、逐题采用、挑战、接续及排除说明。原四题、四项判断、九项挑战摘要及三SourceRef逐项继承；新增文件保持原字节，历史授权文字不回写。保留前版所有清单ID和真实缺项。\n\n## 依赖和边界\n原脚本仅作为文本保存，不在宿主执行。完整复算仍需本对话原包的两份Relay原始ZIP及prior/v1_1_source_audit_receipt.json、prior/v1_1_request.json；当前公开档案不包含全部运行依赖。供应商再分发权、原PDF缺失、完整历史ZIP未迁移及旧来源核查例外继续保留。文件身份和算术不代签研究质量。\n\n## 正常阅读\n本次为delta，须连同确切前驱及原报告读取。可沿清单原件定位，Brief只采用确切已存原文；不制造人工focus、接受、Review或定时通知。无新判别证据不重跑原池与十项Relay。\n"},"item":{"end":16,"reference":{"commit":"aef0db7b96474f3a022c025584314c292351ebcd","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-custody-supplement/record.json","repository":"auguspp/Decision-OS-2","sha256":"5f719d5adad5291636b9414e033e9683f955d5fab30f78539105d9bed39af518"},"start":1},"predecessor":{"commit":"da74578146e91f68defefab576acd9feb88cb066","path":"research/cases/g-explore-20261016/revisions/sopo-quick-20261017-v1-2-records/record.json","repository":"auguspp/Decision-OS-2","sha256":"171660d7b8debbc8252916e4b764abe43371f45b1a5a908b98f8d1d510830a5b"},"status":"readable","version_id":"df2972cd13b96a87d93983614f45efdc1b0d50d78c262ad81eaad875c9a27d26"}],"time_basis":"stored-time-not-event-time-or-research-completion"},"schema":"dos2-news-edition-v2","window":{"as_of":"2026-10-16T09:04:47.720115+00:00","coverage":{"complete_news_coverage":false,"continuous_capture_verified":false,"failed_source_windows":10,"gap_meaning":"OBSERVATION_CLOCK_GAPS_NOT_PROOF_OF_NO_NEWS","maximum_observation_gap_seconds":60922.631273,"retained_batches":13,"retained_versions":1187,"unlocated_source_windows":2},"index_sha256":"6affc6e919940e7c878090f3fd7c8bc2708e2ac6334c807400a82f3a657f2c55","logical_sha256":"cb223ff1b7dcdc63161394917fefeb87524bf4f5ed90efd128e577601ff1115c","losses":[],"predecessor":{"reference":{"manifest":{"commit":"0291d98be501d21a5434f4bc26bedc7884bffbb7","path":"source-views/news-roll-news-two-source-recovery-20261016/aa39f103feb36a7828d199022ab4a8648f5add6a37d75c5841d958a97e3a4189/manifest.json","repository":"auguspp/Decision-OS-2","sha256":"2b8c25ec5557acec3020f7ea9507b255647936e87f1ff828e650dbb4a70a4e12"},"selection":{"columns":[],"end":null,"kind":"all","start":null}},"status":"restored-exact-reference"},"rejected_references":[],"source_outcomes":[{"clock_basis":"legacy-observed-at-not-receipt-clock","observed_at":"2026-10-16T02:00:10.351388+00:00","outcome":{"observations":30,"source":"cls","status":"captured"},"reference":{"manifest":{"commit":"728c4fa4ab44f4dfe4f16833f5f15ed49f2444b4","path":"source-views/news-window-38838107916/ff04cf996a665f2fe7c8bab2528fa97bb85d79f8faea749d36b02a4086ad06d8/manifest.json","repository":"auguspp/Decision-OS-2","sha256":"20a822889e880e6453e14ae13cc57522e251397b03a2732281738b89ff9a3bb0"},"selection":{"columns":[],"end":null,"kind":"all","start":null}}},{"clock_basis":"unlocated-within-selected-batch","observed_at":null,"outcome":{"observations":null,"source":"wallstreetcn","status":"unavailable"},"reference":{"manifest":{"commit":"728c4fa4ab44f4dfe4f16833f5f15ed49f2444b4","path":"source-views/news-window-38838107916/ff04cf996a665f2fe7c8bab2528fa97bb85d79f8faea749d36b02a4086ad06d8/manifest.json","repository":"auguspp/Decision-OS-2","sha256":"20a822889e880e6453e14ae13cc57522e251397b03a2732281738b89ff9a3bb0"},"selection":{"columns":[],"end":null,"kind":"all","start":null}}},{"clock_basis":"legacy-observed-at-not-receipt-clock","observed_at":"2026-10-16T02:00:10.351388+00:00","outcome":{"observations":30,"source":"fastbull","status":"captured"},"reference":{"manifest":{"commit":"728c4fa4ab44f4dfe4f16833f